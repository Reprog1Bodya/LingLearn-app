# ============================================================================
# LingLearn Backend — переменные окружения (локальный запуск без Docker)
# Скопируйте в server/.env:  cp .env.example .env   (файл .env в git не попадает)
# ============================================================================

HOST=0.0.0.0
PORT=8080
DEBUG=false

# PostgreSQL (основная СУБД). Быстрее всего поднять БД так:  docker compose up -d db
DATABASE_URL=postgresql+psycopg2://linglearn:linglearn@localhost:5432/linglearn
# Для быстрой локальной проверки без PostgreSQL можно явно выбрать SQLite:
# DATABASE_URL=sqlite:///./linglearn.db

# Миграции Alembic применяются автоматически при старте сервера
AUTO_MIGRATE=true

# Секрет подписи JWT — ОБЯЗАТЕЛЕН, минимум 32 символа, в коде значения по умолчанию нет.
# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Восстановление пароля: код живёт N минут; в ответ API его отдавать только на отладке
RESET_CODE_TTL_MINUTES=15
DEV_EXPOSE_RESET_CODE=false

# Начальные данные (seed)
SEED_ON_STARTUP=true
ADMIN_EMAIL=admin@linglearn.local
ADMIN_USERNAME=Administrator
ADMIN_PASSWORD=change_me_admin_password

# Записывать адрес сервера в client/server.cfg при запуске server.py
WRITE_CLIENT_CONFIG=true
